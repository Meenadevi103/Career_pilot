# ==========================================
# CareerPilot AI - Environment Configuration
# Copy this file to .env and configure secrets
# ==========================================

# Application
PROJECT_NAME="CareerPilot AI"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=False
COOKIE_NAME="access_token"

# Database Configuration (PostgreSQL + pgvector on Docker port 5433)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_DB=careerpilot
POSTGRES_USER=careerpilot_user
POSTGRES_PASSWORD=careerpilot_password

# Database URL for async SQLAlchemy (psycopg driver)
DATABASE_URL=postgresql+psycopg://careerpilot_user:careerpilot_password@localhost:5433/careerpilot
TEST_DATABASE_URL=postgresql+psycopg://careerpilot_user:careerpilot_password@localhost:5433/careerpilot_test

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# CORS & Frontend Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
FRONTEND_URL=http://localhost:5173

# Frontend Environment Variable
VITE_API_URL=http://localhost:8000
